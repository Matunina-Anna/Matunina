matrix = [
    [ 1, -2,  3],
    [ 4,  9, -15],
    [ 7,  8,  6]
]

n = len(matrix)
# 1. Ищем координаты (строку и столбец) максимального по модулю элемента
max_val = -1
max_row = 0
max_col = 0
for i in range(n):
    for j in range(n):
        # abs() берет модуль числа
        if abs(matrix[i][j]) > max_val:
            max_val = abs(matrix[i][j])
            max_row = i
            max_col = j
# 2. Меняем местами строки
# Если максимальный элемент не в первой строке, меняем их местами
if max_row != 0:
    matrix[0], matrix[max_row] = matrix[max_row], matrix[0]

# 3. Меняем местами столбцы
# Если максимальный элемент не в первом столбце, меняем их местами
if max_col != 0:
    for i in range(n):
        # Меняем элементы местами в каждой строке
        matrix[i][0], matrix[i][max_col] = matrix[i][max_col], matrix[i][0]

# Вывод результата
print("Преобразованная матрица:")
for row in matrix:
    print(row)
