n=int(input()) #ввод элементов массива
#Считываем строку, разбиваем по пробелам и ппревращаем в списаок дробных чисел. Элементов должно быть больше 0
if n>=0:
    ar=list(map(float,input().split())) #введите числа через пробел
    if len(ar)!=0:
        x=float(input()) #Ввод границ x y с клавиатуры
        y=float(input())
        if x>y:
            x,y=y,x #Если получилось так что x>y, меняем месами
        pr = 1
        f=False
        for n in ar:
            if x<=n<=y:
                pr=pr*n
                f=True
        if f==True:
            print(pr)
        else:
            print('Нет чисел из массива')
