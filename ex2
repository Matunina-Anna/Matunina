def truncate_middle(s, max_len):
    if len(s)<=max_len:
        return s
    if max_len<3:
        raise ValueError('max_len must be at least 3to fit"..."')
    chart_to_keep=max_len-3
    left_len=(chart_to_keep+1)//2
    right_len=chart_to_keep-left_len
    return s[:left_len]+"..."+s[-right_len]
